rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- POMOCNÉ GLOBÁLNÍ FUNKCE ---
    function isLogged() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isLogged() && request.auth.token.isSuperAdmin == true;
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isLogged() && request.auth.token.isAdmin == true);
    }

    // --- KOLEKCE UŽIVATELŮ A SEZÓNNÍ MONOLITY ---
    match /users/{userId} {
      // 🔒 Bezpečné čtení: Hráč vidí svůj profil pro přihlášení, Admin vidí všechny pro soupisku
      allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
      
      // 🔓 Povolí vytvoření profilu (přidělení admin práv i kompetencí blokováno)
      allow create: if isLogged() && (
        isSuperAdmin() || (
          request.auth.uid == userId && 
          request.resource.data.get('isAdmin', false) == false && 
          request.resource.data.get('isSuperAdmin', false) == false &&
          request.resource.data.get('adminLeagues', []).size() == 0
        )
      );

      // 🛡️ NEPRŮSTŘELNÝ UPDATE: Super Admin smí vše, hráč smí upravit profil, 24h cooldown na pořadí
      allow update: if isLogged() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId && 
          request.resource.data.get('isAdmin', false) == false && 
          request.resource.data.get('isSuperAdmin', false) == false &&
          
          // 🛑 ZÁKAZ ZMĚNY ADMIN PRÁV A KOMPETENCÍ
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSuperAdmin', 'adminLeagues']) &&
          
          // 🏆 LICENCE: Běžný hráč nesmí pole 'leagues' vůbec měnit (spravuje výhradně Super Admin)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leagues']) &&
          
          // ⏱️ 24H COOLDOWN & INTEGRITA: Platí pouze pro uživatelské pořadí soutěží (leagueOrder)
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leagueOrder']) ||
            (
              request.resource.data.get('leagueOrder', []) is list &&
              request.resource.data.get('leagueOrder', []).size() <= 10 &&
              request.resource.data.get('lastLeagueOrderChange', null) == request.time &&
              (!('lastLeagueOrderChange' in resource.data) || request.time > resource.data.lastLeagueOrderChange + duration.value(24, 'h'))
            )
          )
        )
      );
      
      // 🗑️ Mazat účty hráčů smí pouze Super Admin
      allow delete: if isSuperAdmin();

      // 🔒 SEZÓNNÍ TIPY: Čtení pro majitele/admina, zápis přes Cloud Functions (Admin SDK) nebo Super Admina
      match /sezony/{sezonaId} {
        allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
        allow write: if isSuperAdmin();
        
        match /{subcollection=**} {
          allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
          allow write: if isSuperAdmin();
        }
      }
    }

    // --- LIGOVÝ APARÁT, SEZÓNY A ZÁPASY ---
    match /ligy/{ligaId} {
      allow read: if isLogged();
      allow write: if isSuperAdmin();

      match /sezony/{sezonaId} {
        allow read: if isLogged();
        allow write: if isSuperAdmin();

        match /zapasy/{zapasId} {
          allow read: if isLogged();
          allow write: if isSuperAdmin();
        }
      }

      match /zapasy/{zapasId} {
        allow read: if isLogged();
        allow write: if isSuperAdmin();
      }

      match /stav/{stavId} {
        allow read: if isLogged();
        allow write: if isSuperAdmin();
      }
    }

    // --- SYSTÉMOVÁ KONFIGURACE (BOT CONFIG / SYSTEM) ---
    match /system/{docId} {
      allow read: if isLogged();
      allow write: if isSuperAdmin();
    }

    // --- 📊 PRŮZKUMY & ANKETY ---
    match /ankety/{anketaId} {
      allow read: if isLogged();
      allow write: if isAdmin();

      match /hlasy/{userId} {
        // Hráč vidí jen svůj hlas, admin vidí všechny (pro audit jmen)
        allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
        
        // Hlasovat lze pouze pod svým UID, v běžící anketě před deadlinem
        allow create, update: if isLogged() && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            get(/databases/$(database)/documents/ankety/$(anketaId)).data.get('isOpen', true) != false &&
            get(/databases/$(database)/documents/ankety/$(anketaId)).data.get('stav', 'AKTIVNI') == 'AKTIVNI' &&
            (
              !('konecDatum' in get(/databases/$(database)/documents/ankety/$(anketaId)).data) ||
              request.time < get(/databases/$(database)/documents/ankety/$(anketaId)).data.konecDatum
            ) &&
            request.resource.data.get('hlasovanoAt', null) == request.time
          )
        );
        allow delete: if isAdmin();
      }
    }
  }
}