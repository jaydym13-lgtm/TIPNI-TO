{
  "rules": {
    "live_ticks": {
      ".read": true,
      ".write": false
    },
    "status": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "stats": {
      ".read": true,
      ".write": false
    },
    "guest_presence": {
      ".read": true,
      "$guestId": {
        ".write": "auth != null && auth.uid === $guestId",
        ".validate": "newData.hasChildren(['online', 'ts']) && newData.child('online').isBoolean() && newData.child('ts').isNumber()"
      }
    },
    "guest_stats": {
      ".read": true,
      "total": {
        ".write": "auth != null",
        ".validate": "newData.isNumber()"
      },
      "lastSeen": {
        ".write": "auth != null",
        ".validate": "newData.isNumber()"
      }
    },
    "admin_roster": {
      ".read": "auth != null && (auth.token.isAdmin === true || auth.token.isSuperAdmin === true)",
      "$uid": {
        ".write": "auth != null && auth.token.isSuperAdmin === true",
        "isAdmin": {
          ".validate": "newData.val() === false || (auth != null && auth.token.isSuperAdmin === true)"
        },
        "isSuperAdmin": {
          ".validate": "newData.val() === false || (auth != null && auth.token.isSuperAdmin === true)"
        },
        "leagues": {
          ".validate": "!newData.exists() || data.val() === newData.val() || (auth != null && auth.token.isSuperAdmin === true)"
        },
        "adminLeagues": {
          ".validate": "!newData.exists() || data.val() === newData.val() || (auth != null && auth.token.isSuperAdmin === true)"
        }
      }
    },
    "skupiny": {
      ".read": "auth != null && auth.token.isSuperAdmin === true",
      ".write": false
    },
    "user_groups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "system": {
      "leagues_pulse": {
        ".read": true,
        ".write": false
      },
      "hof_pulse": {
        ".read": true,
        ".write": false
      }
    }
  }
}